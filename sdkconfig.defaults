# PSRAM (8MB Octal) — instruction execution + rodata enabled for ELF modules
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Cache tuning (Phase 5 — module-heavy workload)
# 32KB I-cache, 64B lines, 8-way: amortizes ~50-100 cycle PSRAM miss
# across 16 instructions; 8-way prevents thrash with 4+ concurrent modules.
CONFIG_ESP32S3_INSTRUCTION_CACHE_SIZE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_SIZE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y

# Flash (16MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console / UART
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Watchdog
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# Main task stack — package install + HTTP + ELF load needs more than 3584
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# FATFS long filename support — required for >3-char extensions like .mpkg
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# ELF loader — modules load to PSRAM (auto-selects CACHE_OFFSET on S3).
# The historic LoadStoreError on module .rodata strings was NOT a
# PSRAM-vs-SRAM issue: the upstream loader stored an over-aligned .text
# size whose phantom 1-3 byte range swallowed the first .rodata object and
# remapped its pointer into the ibus-only 0x42xxxxxx alias. Fixed at the
# root in our vendored fork (components/elf_loader, PATCH-001); see
# docs/2026-07-20-elf-loader-psram-rodata-fix.md. Fallback if hardware
# testing ever regresses: set CONFIG_ELF_LOADER_LOAD_PSRAM=n.
CONFIG_ELF_LOADER_LOAD_PSRAM=y
